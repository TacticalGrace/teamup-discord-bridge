# ---------------------------------------------------------------------------
# teamup-discord-bridge
# Copy to .env for local runs. On Render, set these as environment variables.
# ---------------------------------------------------------------------------

# --- Teamup ----------------------------------------------------------------
# The calendar key is the last path segment of the public Teamup link.
# e.g. https://teamup.com/ksabc123def456  ->  ksabc123def456
TEAMUP_CALENDAR_KEY=

# Preferred: free API key from https://teamup.com/api-keys/request
# With this set, the bridge uses the Teamup REST API (best data quality).
TEAMUP_API_KEY=

# Fallback: if you have no API key yet, paste the calendar's iCal feed URL
# (Teamup calendar -> Preferences -> Calendar -> iCal feed).
# Used only when TEAMUP_API_KEY is empty.
TEAMUP_ICS_URL=

# Public link included in every post. Defaults to https://teamup.com/<key>
TEAMUP_PUBLIC_URL=

# Optional: only watch these Teamup sub-calendars (comma-separated numeric IDs).
# Leave blank to watch all of them.
TEAMUP_SUBCALENDAR_IDS=

# --- Discord ---------------------------------------------------------------
# Channel Settings -> Integrations -> Webhooks -> New Webhook -> #announcements
DISCORD_WEBHOOK_URL=

# Optional: role to ping on reminders, e.g. 123456789012345678 (ID, not name).
# Leave blank for no ping. Use "everyone" or "here" for @everyone / @here.
DISCORD_MENTION_ROLE_ID=

# Optional cosmetic overrides for the webhook identity.
DISCORD_USERNAME=Chapter Calendar
DISCORD_AVATAR_URL=

# --- Behavior --------------------------------------------------------------
# Shown in post footers and written into the iCalendar PRODID.
ORG_NAME=Your Chapter Name

TIMEZONE=America/Chicago

# Minutes before an event to post a countdown reminder (comma-separated).
# 10080 = 1 week, 1440 = 1 day, 120 = 2 hours.
REMINDER_OFFSETS_MINUTES=1440,120

# Post when an event is added, rescheduled, moved, or cancelled.
CHANGE_ALERTS_ENABLED=true

# Weekly digest: one post listing everything in the next 7 days.
DIGEST_ENABLED=true
DIGEST_DAY=friday
DIGEST_HOUR=9
DIGEST_MINUTE=0

# The greeting that opens the digest post. Write it however the chapter talks.
DIGEST_INTRO=Hey y'all! Here's what we have going on this week. Hope you can make it!

# How the digest is laid out:
#   grouped  - day headings, event names prominent, details in small grey subtext
#   compact  - two lines per event, no descriptions
#   cards    - one Discord embed field per event
#   flat     - one long line per event
DIGEST_LAYOUT=grouped

# --- Add to calendar -------------------------------------------------------
# Puts "Add to your calendar" links on event posts.
ADD_TO_CALENDAR_ENABLED=false

# Public URL this service is reachable at, used to serve .ics downloads for
# Apple Calendar / Outlook desktop / Thunderbird. On Render this is filled in
# automatically from RENDER_EXTERNAL_URL — leave it blank there.
# Blank means the .ics link is omitted; Google and Outlook Web still work.
PUBLIC_BASE_URL=

# Signs .ics links so this endpoint can't be used to serve arbitrary calendar
# files. Derived from the webhook URL when blank, which is fine. Only set it if
# you rotate the webhook and want previously posted links to keep working.
LINK_SECRET=

# How often to poll Teamup, and how far ahead to look.
POLL_INTERVAL_MINUTES=10
HORIZON_DAYS=60

# Where dedup state lives. On Render, point this at a mounted disk if you
# have one (e.g. /var/data/state.json); otherwise the default is fine.
STATE_FILE=./data/state.json

# Log what would be posted without actually posting. Great for first run.
DRY_RUN=false

# --- Server ----------------------------------------------------------------
PORT=10000

# Optional: enables POST /run?token=... to force a check immediately.
ADMIN_TOKEN=
